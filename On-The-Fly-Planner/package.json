{
  "name": "fa-18c-otfp",
  "version": "1.1.4",
  "description": "F/A-18C Mission Planner and Moving Map",
  "main": "main.js",
  "author": "Your Name",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "productName": "fa-18c-otfp",
    "appId": "com.vfaplanner.app",
    "directories": {
      "output": "dist"
    },
    
    "icon": "public/assets/icon.ico",

    "win": {
      "target": "nsis",
      "icon": "public/assets/icon.ico"
    },
    
    "nsis": {
      "oneClick": false,
      "perMachine": false, 
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OTFP",
      "installerIcon": "public/assets/icon.ico",
      "uninstallerIcon": "public/assets/icon.ico",
      "runAfterFinish": true,
      "artifactName": "fa-18c-otfp.exe",
      "guid": "com.vfaplanner.app"
    },

    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "server.js",
      "public/**/*",
      "!dist",
      "!**/*.map"
    ],

    "extraResources": [
      {
        "from": "dcs-scripts",
        "to": "dcs-scripts"
      }
    ]
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}